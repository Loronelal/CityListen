{
  "info": {
    "name": "CityListen API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has status ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "2. Stories CRUD",
      "item": [
        {
          "name": "Create Story",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has text', function () { pm.expect(pm.response.json()).to.have.property('text'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"placeId\": \"osm:123\",\n  \"language\": \"ru\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/stories", "host": ["{{baseUrl}}"], "path": ["v1", "stories"] }
          }
        },
        {
          "name": "Get My Stories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has items array', function () { pm.expect(pm.response.json()).to.have.property('items'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/v1/stories", "host": ["{{baseUrl}}"], "path": ["v1", "stories"] }
          }
        },
        {
          "name": "Get Story By ID (Negative: 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/v1/stories/wrong_id", "host": ["{{baseUrl}}"], "path": ["v1", "stories", "wrong_id"] }
          }
        }
      ]
    },
    {
      "name": "3. History CRUD",
      "item": [
        {
          "name": "Add to History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"storyId\": \"story_123\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/history", "host": ["{{baseUrl}}"], "path": ["v1", "history"] }
          }
        },
        {
          "name": "Get My History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has items array', function () { pm.expect(pm.response.json()).to.have.property('items'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/v1/history?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["v1", "history"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "20"}] }
          }
        },
        {
          "name": "Delete History Item (Negative: 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/v1/history/wrong_id", "host": ["{{baseUrl}}"], "path": ["v1", "history", "wrong_id"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://citylisten-api.citylisten.workers.dev", "type": "string" },
    { "key": "jwtToken", "value": "ВСТАВЬ_СЮДА_ТОКЕН", "type": "string" }
  ]
}